{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recruit-agent-mcp",
  "main": "src/adapters/driving/mcp/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }, { "binding": "SESSION_KV" }],
  "ratelimits": [
    {
      "name": "AUTHORIZE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "triggers": { "crons": ["17 */6 * * *"] },
  "secrets": {
    "required": ["AUTH_PASSWORD"]
  }
}
